---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Menú — TailorMind Take-Home">
	<main class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="text-3xl font-bold">Menú</h1>
		<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_320px] lg:items-start">
			<div id="menu">
				<div class="grid gap-4 sm:grid-cols-2">
					{
						Array.from({ length: 6 }).map(() => (
							<div class="h-[184px] animate-pulse rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
								<div class="h-5 w-2/3 rounded bg-stone-200" />
								<div class="mt-2 h-4 w-full rounded bg-stone-100" />
								<div class="mt-3 h-5 w-24 rounded bg-stone-100" />
								<div class="mt-4 h-9 w-full rounded-lg bg-stone-100" />
							</div>
						))
					}
				</div>
			</div>
			<aside class="lg:sticky lg:top-6">
				<div id="cart-body">
					<div class="rounded-xl border border-sky-200 bg-sky-50 p-4 text-sky-800" role="status">
						Tu carrito está vacío
					</div>
				</div>
				<form id="order-form" class="mt-4 hidden rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
					<h2 class="text-xl font-semibold">Tus datos</h2>
					<label class="mt-3 block text-sm font-medium">
						Nombre
						<input
							name="nombre"
							type="text"
							required
							autocomplete="name"
							class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none"
						/>
					</label>
					<label class="mt-3 block text-sm font-medium">
						Email
						<input
							name="email"
							type="email"
							required
							autocomplete="email"
							placeholder="nombre@dominio.cl"
							class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none"
						/>
					</label>
					<button
						type="submit"
						data-enviar
						class="mt-4 w-full rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white hover:bg-brand-600 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none"
					>
						Enviar orden
					</button>
				</form>
				<div id="order-status" class="mt-4"></div>
			</aside>
		</div>
	</main>
	<script>
		import { initMenu } from '../scripts/menu';
		import { initCart } from '../scripts/cart';
		import { initOrder } from '../scripts/order';
		initMenu();
		initCart();
		initOrder();
	</script>
</Layout>
