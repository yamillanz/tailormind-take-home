---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Menú — TailorMind Take-Home">
	<main class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="text-3xl font-bold">Menú</h1>
		<div id="menu" class="mt-6">
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					Array.from({ length: 6 }).map(() => (
						<div class="h-[132px] animate-pulse rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
							<div class="h-5 w-2/3 rounded bg-stone-200" />
							<div class="mt-2 h-4 w-full rounded bg-stone-100" />
							<div class="mt-3 h-5 w-24 rounded bg-stone-100" />
						</div>
					))
				}
			</div>
		</div>
	</main>
	<script>
		import { initMenu } from '../scripts/menu';
		initMenu();
	</script>
</Layout>
