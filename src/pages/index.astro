---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Menú — TailorMind Take-Home">
	<main class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="text-3xl font-bold">Menú</h1>
		<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_320px] lg:items-start">
			<div id="menu">
				<div class="grid gap-4 sm:grid-cols-2">
					{
						Array.from({ length: 6 }).map(() => (
							<div class="h-[184px] animate-pulse rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
								<div class="h-5 w-2/3 rounded bg-stone-200" />
								<div class="mt-2 h-4 w-full rounded bg-stone-100" />
								<div class="mt-3 h-5 w-24 rounded bg-stone-100" />
								<div class="mt-4 h-9 w-full rounded-lg bg-stone-100" />
							</div>
						))
					}
				</div>
			</div>
			<aside id="cart" class="lg:sticky lg:top-6">
				<div class="rounded-xl border border-sky-200 bg-sky-50 p-4 text-sky-800" role="status">
					Tu carrito está vacío
				</div>
			</aside>
		</div>
	</main>
	<script>
		import { initMenu } from '../scripts/menu';
		import { initCart } from '../scripts/cart';
		initMenu();
		initCart();
	</script>
</Layout>
